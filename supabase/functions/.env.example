# 复制为本地 .env.local 后填写。不要提交真实密钥。
AI_API_KEY=replace-with-your-model-api-key
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_STYLE=responses
AI_MODEL=replace-with-your-model-id
AI_PROVIDER=openai

# 使用密码管理器生成至少 32 字节随机字符串。
AI_RATE_LIMIT_SALT=replace-with-a-long-random-string
AI_REQUEST_LIMIT=12
AI_ALLOWED_ORIGINS=https://duyvxi.github.io
# 本机 localhost/127.0.0.1 的任意端口由函数自动允许。
